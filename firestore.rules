rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner
    // NOTE: Replace 'fQvWz8tE9hP8rL6kG4nB2mJ5sD7v' with your actual UID from Firebase Console
    function isOwner() {
      return isAuthenticated() && request.auth.uid == 'fQvWz8tE9hP8rL6kG4nB2mJ5sD7v';
    }
    
    // Portfolio content collections - public read, owner write
    match /services/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /socialLinks/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /stats/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /navItems/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /profile/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /experiences/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /education/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /certifications/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /achievements/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /expertise/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /contactInfo/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /projectDetails/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /heroSection/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    
    match /cv/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Allow public to submit contact form
    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isOwner();
    }
  }
}
